# For Docker: DATABASE_URL="postgresql://postgres:postgres@db:5432/agrivet?schema=public"
# For local:  DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/agrivet_db?schema=public"
PORT=3000

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d

# Docker Compose PostgreSQL (optional — used by docker-compose.yml defaults)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=agrivet

# HTTPS (optional — enable only in production with valid certificates)
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem
