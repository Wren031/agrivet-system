# For Docker: DATABASE_URL="postgresql://postgres:postgres@db:5432/agrivet?schema=public"
# For local:  DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrivet?schema=public"
PORT=3000
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d

# Docker Compose PostgreSQL (optional — used by docker-compose.yml defaults)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agrivet
