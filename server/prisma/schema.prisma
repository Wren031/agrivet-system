generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(uuid())
  password     String
  role         Role          @default(AGENT)
  createdAt    DateTime      @default(now()) @map("created_at")
  adminProfile AdminProfile?
  agentProfile AgentProfile?

  @@map("users")
}

model AdminProfile {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name")
  contactNumber String   @map("contact_number")
  email         String   @unique
  createdAt     DateTime @default(now()) @map("created_at")
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Category {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now()) @map("created_at")
  subcategories SubCategory[]
  inventory    Inventory[]

  @@map("categories")
}

model SubCategory {
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  categoryId String      @map("category_id")
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventory  Inventory[]

  @@unique([name, categoryId])
  @@map("sub_categories")
}

model AgentProfile {
  id                String        @id @default(uuid())
  fullName          String        @map("full_name")
  contactNumber     String        @map("contact_number")
  email             String        @unique
  idVerificationUrl String?       @map("id_verification_url")
  status            AgentStatus   @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  userId            String        @unique @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers         Customer[]

  @@map("agent_profiles")
}

model Customer {
  id             String        @id @default(uuid())
  fullName       String        @map("full_name")
  phone          String
  email          String?
  address        String
  agentProfileId String?       @map("agent_profile_id")
  agentProfile   AgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("customers")
}

model Inventory {
  id             String        @id @default(uuid())
  productName    String        @map("product_name")
  unit           String
  costPrice      Decimal       @map("cost_price") @db.Decimal(10, 2)
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(10, 2)
  stockLevel     Int           @map("stock_level")
  reorderPoint   Int           @map("reorder_point")
  expiryDate     DateTime?     @map("expiry_date")
  imageUrl       String?       @map("image_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  categoryId     String?       @map("category_id")
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?       @map("subcategory_id")
  subcategory    SubCategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@map("inventory")
}
